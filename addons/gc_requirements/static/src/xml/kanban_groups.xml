<templates xml:space="preserve">
    <t t-name="gc_requirements.KanbanGroups" t-inherit="web.KanbanRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_kanban_group')]" position="attributes">
            <attribute name="t-att-data-gc-state">props.list.resModel === 'gc.requirement' &amp;&amp; props.list.groupByField.name === 'state' ? group.value : undefined</attribute>
