<odoo>
    <!-- Native bindings avoid unverified Enterprise/custom view inheritance. -->
    <record id="action_ticket_requirement" model="ir.actions.server">
        <field name="name">Anforderung erstellen/verknüpfen</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="binding_model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('group_user'))]"/>
        <field name="state">code</field><field name="code">action = record.action_gc_requirement()</field>
    </record>
    <record id="action_ticket_requirements" model="ir.actions.server">
        <field name="name">Verknüpfte Anforderungen</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="binding_model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[(4, ref('group_user'))]"/>
        <field name="state">code</field><field name="code">action = records.action_gc_requirements()</field>
    </record>
</odoo>
