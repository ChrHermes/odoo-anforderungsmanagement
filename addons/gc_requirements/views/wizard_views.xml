<odoo>
    <record id="view_decision_form" model="ir.ui.view">
        <field name="name">gc.requirement.decision.form</field><field name="model">gc.requirement.decision</field>
        <field name="arch" type="xml"><form string="Status ändern">
            <group><field name="requirement_id"/><field name="state"/>
                <field name="reason" required="state in ['deferred', 'rejected']" invisible="state not in ['deferred', 'rejected']"/>
            </group>
            <div class="alert alert-info" invisible="state != 'implemented'">Umgesetzt bedeutet: veröffentlicht oder produktiv verfügbar.</div>
            <group invisible="state != 'implemented'"><field name="implemented_version"/><field name="implemented_on"/><field name="implementation_note"/></group>
            <footer><button name="action_apply" type="object" string="Status übernehmen" class="btn-primary"/><button string="Abbrechen" special="cancel"/></footer>
        </form></field>
    </record>
    <record id="view_from_ticket_form" model="ir.ui.view">
        <field name="name">gc.requirement.from.ticket.form</field><field name="model">gc.requirement.from.ticket</field>
        <field name="arch" type="xml"><form string="Anforderung erstellen/verknüpfen">
            <group><field name="ticket_id"/><field name="mode" widget="radio"/>
                <field name="requirement_id" invisible="mode != 'existing'" required="mode == 'existing'" options="{'no_create': True}"/>
            </group>
            <group invisible="mode != 'new'">
                <field name="name" required="mode == 'new'"/><field name="request_type" required="mode == 'new'"/>
                <field name="product_id" required="mode == 'new'" options="{'no_create': True}"/>
                <field name="category_id" domain="[('product_id', '=', product_id)]" options="{'no_create': True}"/>
            </group>
            <div invisible="mode != 'new'"><p>Bitte verfassen Sie eine redaktionelle Beschreibung. Der Tickettext wird getrennt als unveränderliche Quelle gesichert.</p><field name="description" required="mode == 'new'"/>
                <group string="Mögliche Duplikate" invisible="not similar_requirement_ids"><field name="similar_requirement_ids" widget="many2many_tags" options="{'no_create': True}"/></group>
            </div>
            <footer><button name="action_apply" type="object" string="Erstellen / verknüpfen" class="btn-primary"/><button string="Abbrechen" special="cancel"/></footer>
        </form></field>
    </record>
    <record id="view_source_viewer_form" model="ir.ui.view">
        <field name="name">gc.requirement.source.viewer.form</field><field name="model">gc.requirement.source.viewer</field>
        <field name="arch" type="xml"><form string="Autorisierte Ticketquellen" create="0" edit="0" delete="0">
            <field name="requirement_id"/><field name="source_html"/>
            <footer><button string="Schließen" special="cancel"/></footer>
        </form></field>
    </record>
    <record id="view_merge_form" model="ir.ui.view">
        <field name="name">gc.requirement.merge.form</field><field name="model">gc.requirement.merge</field>
        <field name="arch" type="xml"><form string="Duplikat zusammenführen">
            <group><field name="source_id"/><field name="target_id" domain="[('id', '!=', source_id), ('active', '=', True), ('merged_into_id', '=', False)]" options="{'no_create': True}"/>
                <field name="preview"/><field name="confirmed"/>
            </group>
            <footer><button name="action_apply" type="object" string="Zusammenführen und Quelle archivieren" class="btn-primary"/><button string="Abbrechen" special="cancel"/></footer>
        </form></field>
    </record>
</odoo>
